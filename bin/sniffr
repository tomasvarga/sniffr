#!/usr/bin/env bash
# sniffr — an AI sniffs a PR for issues before you review it. It runs an agent
# over the PR diff, anchors each finding to the exact changed line, and injects
# them as LOCAL-DRAFT comments into the terminal reviewer you already have open
# (tuicr/hunk/custom) — or prints them as JSON with --format json.
#
# Host-agnostic: no editor, TUI, or workspace manager required. Point it at a PR
# in whatever reviewer you use; the herdr plugin (herdr-sniffr) wraps this to
# open the pane and wire reload/notify hooks.
#
#   sniffr <pr>                  pr = number | owner/repo#N | URL
#   sniffr <pr> --agent grok           one agent, or a comma list (codex,claude)
#   sniffr <pr> --backend hunk   inject findings into hunk instead of tuicr
#   sniffr <pr> --model <name>   model for the agent (else its default/auto)
#   sniffr <pr> --consensus      merge multi-agent findings into one comment per
#                                bug (agent chips); cheap model via [consensus]
#   sniffr <pr> --min-severity high    only keep critical/high findings
#   sniffr <pr> --bg             review in the background; keep reading meanwhile
#   sniffr <pr> --format json    print resolved findings as JSON (no reviewer)
#   sniffr <pr> --after-inject <cmd>   run <cmd> after findings land (reload hook)
#   sniffr <pr> --notify-cmd <cmd>     run <cmd> to notify (SNIFFR_TITLE/SNIFFR_MSG)
#   sniffr queue [--since 3w]    pick from the PRs awaiting your review
#   sniffr doctor                check deps, gh auth, agent, backend
#   sniffr setup                 print an agent setup prompt (pipe to your agent)
#
# Attach mode: sniffr injects into a reviewer session that is ALREADY OPEN. Open
# it first (`tuicr pr <pr>` / `hunk patch <diff>`), then run sniffr — or use
# --format json and pipe the findings wherever you like.
#
# Comments are LOCAL DRAFTS only — sniffr NEVER posts to GitHub. You prune them
# (dd / :clearc in tuicr) and submit yourself.
#
# Agent (first match wins): --agent flag · SNIFFR_AGENT env · saved default
# (`sniffr --set-agent <name>`, stored in ~/.config/sniffr/agent) · codex.
# SNIFFR_CMD='<cmd>' escape hatch (prompt on stdin -> JSON array on stdout).
# Built-ins: codex · claude · cursor-agent · grok · opencode · ollama.
#
# Backend (where findings go): --backend flag · SNIFFR_BACKEND env · config
# `backend=` in ~/.config/sniffr/config.toml · tuicr. Native support: tuicr,
# hunk (external tools you install). Anything else → a custom [backends.<name>].
set -uo pipefail
die(){ echo "sniffr: $*" >&2; exit 1; }

CONF_DIR="$HOME/.config/sniffr"
CONFIG_FILE="$CONF_DIR/config.toml"

# config.toml as JSON ({} if missing/unparseable). Needs python ≥3.11 (tomllib).
cfg_json(){
  [ -f "$CONFIG_FILE" ] || { echo '{}'; return; }
  python3 -c 'import tomllib,json,sys; print(json.dumps(tomllib.load(open(sys.argv[1],"rb"))))' "$CONFIG_FILE" 2>/dev/null || echo '{}'
}
# backend precedence: --backend flag (BACKEND_OPT) → SNIFFR_BACKEND → config →
# auto-detect an installed native backend (tuicr, then hunk) → tuicr.
resolve_backend(){
  if [ -n "${BACKEND_OPT:-}" ]; then printf '%s' "$BACKEND_OPT"; return; fi
  if [ -n "${SNIFFR_BACKEND:-}" ]; then printf '%s' "$SNIFFR_BACKEND"; return; fi
  local cb; cb=$(cfg_json | jq -r '.backend // empty')
  if [ -n "$cb" ]; then printf '%s' "$cb"; return; fi
  # nothing explicit → use whichever supported reviewer is actually installed
  if   command -v tuicr >/dev/null 2>&1; then printf 'tuicr'
  elif command -v hunk  >/dev/null 2>&1; then printf 'hunk'
  else printf 'tuicr'; fi
}
# helpful message when a native backend's binary is missing — point at an
# installed alternative if there is one, else at how to get set up.
backend_missing_hint(){
  local b="$1" alt=""
  [ "$b" != tuicr ] && command -v tuicr >/dev/null 2>&1 && alt=tuicr
  [ -z "$alt" ] && [ "$b" != hunk ] && command -v hunk >/dev/null 2>&1 && alt=hunk
  if [ -n "$alt" ]; then
    printf "backend '%s' needs the '%s' binary, which isn't installed — but you have '%s'. Use --backend %s, or set backend = \"%s\" in %s." "$b" "$b" "$alt" "$alt" "$alt" "$CONFIG_FILE"
  else
    printf "backend '%s' needs the '%s' binary installed, and no other supported reviewer is available. Install tuicr (tuicr.dev) or hunk (hunk.dev), or define a custom backend in %s." "$b" "$b" "$CONFIG_FILE"
  fi
}
# read a custom backend's command: cfg_backend_cmd <name> <open|inject>
cfg_backend_cmd(){ cfg_json | jq -r --arg n "$1" --arg f "$2" '.backends[$n][$f] // empty'; }
# is $1 a known backend (native or defined in config)?
backend_known(){
  case "$1" in tuicr|hunk) return 0 ;; esac
  [ -n "$(cfg_json | jq -r --arg n "$1" '.backends[$n] // empty')" ]
}
# expand {url}{repo}{num}{diff}{pane} placeholders in a custom command
expand_ph(){ local s="$1"; s=${s//\{url\}/$url}; s=${s//\{repo\}/$repo}; s=${s//\{num\}/$num}; s=${s//\{diff\}/${DIFF_PATH:-}}; s=${s//\{pane\}/${pid:-}}; printf '%s' "$s"; }

# default agent: SNIFFR_AGENT env → saved default file → codex
default_agent(){
  if [ -n "${SNIFFR_AGENT:-}" ]; then printf '%s' "$SNIFFR_AGENT"
  elif [ -s "$CONF_DIR/agent" ]; then tr -d '[:space:]' < "$CONF_DIR/agent"
  else printf 'codex'; fi
}

# agent name → the binary it invokes (cursor is an alias for cursor-agent)
agent_bin(){ case "$1" in cursor) echo cursor-agent ;; *) printf '%s' "$1" ;; esac; }

# date_ago 21d|3w|2mo|1y -> YYYY-MM-DD, portable across BSD (macOS) and GNU (Linux)
date_ago(){
  local spec="$1" num unit bsd
  case "$spec" in
    *mo) num="${spec%mo}"; unit=month; bsd=m ;;
    *d)  num="${spec%d}";  unit=day;   bsd=d ;;
    *w)  num="${spec%w}";  unit=week;  bsd=w ;;
    *y)  num="${spec%y}";  unit=year;  bsd=y ;;
    *) return 1 ;;
  esac
  case "$num" in ''|*[!0-9]*) return 1 ;; esac
  date -v-"${num}${bsd}" +%Y-%m-%d 2>/dev/null && return 0   # BSD / macOS
  date -d "${num} ${unit}s ago" +%Y-%m-%d 2>/dev/null && return 0  # GNU / Linux
  return 1
}

# notify <title> <body> — if SNIFFR_NOTIFY_CMD is set (e.g. herdr-sniffr passes
# `herdr notification show …`), run it with $SNIFFR_TITLE/$SNIFFR_MSG in the env;
# otherwise fall back to an OS notifier. Keeps the core reviewer/host-agnostic.
notify(){
  local title="$1" body="$2"
  if [ -n "${SNIFFR_NOTIFY_CMD:-}" ]; then
    SNIFFR_TITLE="$title" SNIFFR_MSG="$body" sh -c "$SNIFFR_NOTIFY_CMD" >/dev/null 2>&1 || true
  elif command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$title" -message "$body" >/dev/null 2>&1
  elif command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"${body//\"/}\" with title \"${title//\"/}\"" >/dev/null 2>&1
  fi
}

# resolve a PR target into repo / number / tuicr slug
resolve(){
  case "$1" in
    https://github.com/*/pull/*)
      repo=$(printf '%s' "$1" | sed -E 's#https://github.com/([^/]+/[^/]+)/pull/.*#\1#')
      num=$(printf  '%s' "$1" | sed -E 's#.*/pull/([0-9]+).*#\1#') ;;
    */*\#*) repo="${1%#*}"; num="${1#*#}" ;;
    *[0-9]) repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
              || die "bare number needs a repo cwd; pass owner/repo#N or a URL"
            num="$1" ;;
    *) die "unrecognized PR target: $1" ;;
  esac
  slug="gh:$repo/pr/${num}"
  url="https://github.com/$repo/pull/${num}"
}

# ===================== WORKER: review, inject, reload (bg) =====================
if [ "${1:-}" = "--worker" ]; then
  target="$2"; pid="$3"; backend="${4:-tuicr}"
  # one or more agents (comma-separated) — each reviews the diff, stamped by name
  AGENTS="$(default_agent)"; AGENTS="${AGENTS//,/ }"
  [ -n "${SNIFFR_CMD:-}" ] && AGENTS="${AGENTS%% *}"   # SNIFFR_CMD is one command
  # max findings: SNIFFR_MAX env → config `max` → 8
  MAX="${SNIFFR_MAX:-$(cfg_json | jq -r '.max // 8')}"
  # model: SNIFFR_MODEL env (set by --model flag or the caller) → config `model`
  # → empty (each agent's own default). MAIN/--bg pass the resolved value here.
  MODEL="${SNIFFR_MODEL:-$(cfg_json | jq -r '.model // empty')}"
  FORMAT="${SNIFFR_FORMAT:-inject}"   # inject → into the live reviewer session; json → print findings
  # ---- consensus: an optional CHEAP model that merges the multi-agent findings
  # into one deduped, well-written comment per bug (with agent chips). On when
  # [consensus].model is set (or SNIFFR_CONSENSUS / --consensus). Needs >1 agent.
  CMODEL="${SNIFFR_CONSENSUS_MODEL:-$(cfg_json | jq -r '.consensus.model // empty')}"
  CAGENT="${SNIFFR_CONSENSUS_AGENT:-$(cfg_json | jq -r '.consensus.agent // empty')}"
  CPROMPT="${SNIFFR_CONSENSUS_PROMPT:-$(cfg_json | jq -r '.consensus.prompt // empty')}"
  CONSENSUS=0; { [ -n "${SNIFFR_CONSENSUS:-}" ] || [ -n "$CMODEL" ]; } && CONSENSUS=1
  [ -n "${SNIFFR_CMD:-}" ] && CONSENSUS=0            # SNIFFR_CMD is a single custom command
  [ -n "$CAGENT" ] || CAGENT="${AGENTS%% *}"          # default = first review agent
  # noise filters: keep only findings at/above a severity and/or confidence.
  # A finding missing the field is kept (never silently drop an unranked bug).
  MIN_SEV="${SNIFFR_MIN_SEVERITY:-$(cfg_json | jq -r '.min_severity // empty')}"
  MIN_CONF="${SNIFFR_MIN_CONFIDENCE:-$(cfg_json | jq -r '.min_confidence // empty')}"
  # default consensus instruction (writes findings up per good-PR-comment practice)
  DEFAULT_CPROMPT="You are consolidating code-review findings from several AI reviewers of the same pull request into one clean, high-signal review. You receive a JSON array of findings (each: file, line, severity, type, body, recommendation, confidence, agent). Apply the standards of an excellent reviewer. CLUSTER: group findings that describe the SAME underlying defect — even if anchored to adjacent lines or worded differently — into one; only merge when it is clearly the same defect; keep genuinely distinct bugs separate (two different problems on one line stay separate); a finding reported by a single reviewer stays on its own. WRITE each merged finding as one comment that states WHAT is wrong (anchored to the line), WHY it matters (do not restate what the code does), the TRIGGER (the concrete input, state, or sequence under which it fails), and a concrete one-line FIX. Be specific, never speculative, and never invent behavior. SEVERITY = the highest in the group (critical|high|medium|low). Drop style, naming, and formatting nits. SUPPRESS NOISE: prefer fewer, higher-confidence findings; drop a finding that only one reviewer raised AND with confidence below 0.5, unless it is a security, correctness, or data-loss risk — an empty result is better than speculative noise. Output ONLY a JSON array (no prose, no fences). Each element: {\"file\":\"<path>\",\"line\":<best single new-side line>,\"severity\":\"critical|high|medium|low\",\"type\":\"bug|risk|question|note\",\"body\":\"<the written-up comment: what + why + trigger, concise>\",\"recommendation\":\"<one-line concrete fix>\",\"agents\":[\"<distinct reviewers that flagged it>\"]}. Sort by severity (critical first). Use confidence only internally to choose the representative wording and to suppress noise; do not output it."
  resolve "$target"
  diff=$(gh pr diff "${num}" --repo "$repo" 2>/dev/null) || exit 0
  [ -n "$diff" ] || exit 0
  # review INSTRUCTIONS are configurable (SNIFFR_PROMPT env → config `prompt` →
  # default); the OUTPUT CONTRACT below is fixed — the resolver depends on this
  # exact JSON shape and the verbatim `code` quote, so it is NOT user-editable.
  instructions="${SNIFFR_PROMPT:-$(cfg_json | jq -r '.prompt // empty')}"
  [ -n "$instructions" ] || instructions="You are an expert code reviewer doing a first pass over a pull request's unified diff, and your sole job is to surface findings a senior engineer would consider must-fix: genuine bugs, logic and correctness errors, security vulnerabilities (including injection and broken authentication or authorization), data loss or corruption, race conditions and other concurrency hazards, resource leaks, unhandled or swallowed errors, and changes that break the documented or evident contract of an API or behavior. Also scrutinize code that parses, converts, or validates external input for exceptions that propagate uncaught and for unchecked value ranges (for example, numeric conversions that can throw, or amounts and sizes that are never bounds-checked). Read the diff as one coherent change — trace how added, modified, and removed code interacts across hunks and with its surrounding context — rather than judging lines in isolation. Report a finding only when you can point to a concrete flaw and describe the specific input, state, or sequence of events under which it misbehaves; if the problem depends on unseen code or unverified assumptions, stay silent. Ignore style, formatting, naming, comments, test coverage, and all subjective preferences — an empty review is better than a speculative one."
  prompt="${instructions}

Output ONLY a JSON array — no prose, no markdown fences. Each item:
{\"file\":\"<path on the new side>\",\"code\":\"<the ONE line this finding is about, copied VERBATIM from a '+' or context line in the diff, WITHOUT the leading +/space>\",\"line\":<new-side line number if you are certain, else null>,\"type\":\"bug|risk|question|note\",\"severity\":\"critical|high|medium|low\",\"confidence\":<your certainty from 0.0 to 1.0>,\"body\":\"<concise finding>\",\"recommendation\":\"<the concrete fix in one line, or omit>\"}
The \"code\" field is what locates the line — copy it character-for-character from
the diff; do NOT paraphrase, reindent, or reformat it. Set \"severity\" by impact
and \"confidence\" by how sure you are it is a real defect. At most ${MAX} items.
If nothing significant, output [].

DIFF:
${diff}"
  scratch=$(mktemp -d); trap 'rm -rf "$scratch"' EXIT
  printf '%s' "$diff" > "$scratch/diff.patch"
  DIFF_PATH="$scratch/diff.patch"
  # extractor: pull the largest JSON array-of-objects out of a model's stdout.
  # (A FILE, not `python3 - <<PY`, so it can be used on the receiving end of a pipe.)
  cat > "$scratch/xarr.py" <<'PY'
import sys, json, re
s = sys.stdin.read(); best = []
for i in [m.start() for m in re.finditer(r'\[', s)]:
    for j in range(len(s), i, -1):
        if s[j-1] != ']': continue
        try: v = json.loads(s[i:j])
        except Exception: continue
        if isinstance(v, list) and (not v or all(isinstance(x, dict) for x in v)):
            if len(v) >= len(best): best = v
            break
print(json.dumps(best))
PY
  run_agent(){
    local ag="$1"
    if [ -n "${SNIFFR_CMD:-}" ]; then printf '%s' "$prompt" | ( cd "$scratch" && eval "$SNIFFR_CMD" ); return; fi
    ( cd "$scratch"
      case "$ag" in
        codex)               printf '%s' "$prompt" | codex exec --skip-git-repo-check ${MODEL:+--model "$MODEL"} - 2>/dev/null ;;
        claude)              printf '%s' "$prompt" | claude -p ${MODEL:+--model "$MODEL"} 2>/dev/null ;;
        cursor|cursor-agent) cursor-agent -f -p ${MODEL:+--model "$MODEL"} --output-format text "$prompt" 2>/dev/null ;;
        grok)                grok -p ${MODEL:+--model "$MODEL"} "$prompt" 2>/dev/null ;;
        opencode)            opencode run ${MODEL:+-m "$MODEL"} "$prompt" 2>/dev/null ;;
        ollama)              printf '%s' "$prompt" | ollama run "${MODEL:-llama3.1}" 2>/dev/null ;;
      esac )
  }
  # consensus runner: explicit agent + (cheap) model, prompt on stdin
  run_model(){
    local ag="$1" m="$2" p; p="$(cat)"
    case "$ag" in
      claude)              printf '%s' "$p" | claude -p ${m:+--model "$m"} 2>/dev/null ;;
      cursor|cursor-agent) cursor-agent -f -p ${m:+--model "$m"} --output-format text "$p" 2>/dev/null ;;
      grok)                grok -p ${m:+--model "$m"} "$p" 2>/dev/null ;;
      opencode)            opencode run ${m:+-m "$m"} "$p" 2>/dev/null ;;
      ollama)              printf '%s' "$p" | ollama run "${m:-llama3.1}" 2>/dev/null ;;
      *)                   printf '%s' "$p" | codex exec --skip-git-repo-check ${m:+--model "$m"} - 2>/dev/null ;;
    esac
  }
  # render a finding's comment body: "<icon> <severity> · <type>[ · N agents (chips)]"
  # then the finding, then "↳ fix: …". Agent chips appear only for merged
  # (consensus) findings that carry an `agents` array. Type is in the text because
  # some backends (hunk) have no native type field. Confidence is never shown.
  mkbadge(){
    local it="$1" sev typ body rec chips nag icon head disp
    sev=$(jq -r '.severity // ""' <<<"$it"); typ=$(jq -r '.type // "note"' <<<"$it")
    body=$(jq -r '.body // ""' <<<"$it"); rec=$(jq -r '.recommendation // ""' <<<"$it")
    chips=$(jq -r '(.agents // []) | join("·")' <<<"$it"); nag=$(jq -r '(.agents // []) | length' <<<"$it")
    case "$sev" in critical) icon="🔴";; high) icon="🟠";; medium) icon="🟡";; low) icon="⚪";; *) icon="";; esac
    [ -n "$sev" ] && head="$icon $sev · $typ" || head="$typ"
    [ "${nag:-0}" -gt 0 ] && head="$head · ${nag} agent$([ "$nag" = 1 ] || echo s) ($chips)"
    disp="$head"$'\n'"$body"
    [ -n "$rec" ] && [ "$rec" != null ] && disp="$disp"$'\n'"↳ fix: $rec"
    printf '%s' "$disp"
  }
  # ---- locate the live backend session ONCE (inject mode only) -------------
  found=0; sid=""; patch="${TMPDIR:-/tmp}/sniffr-${num}.patch"
  printf '[]' > "$scratch/all.json"   # accumulator for --format json
  if [ "$FORMAT" != json ]; then
    case "$backend" in
      tuicr) for _ in $(seq 1 45); do tuicr review list --repo "$repo" 2>/dev/null | jq -e --arg s "$slug" 'any(.[]?; .slug==$s)' >/dev/null 2>&1 && { found=1; break; }; sleep 0.7; done ;;
      hunk)  for _ in $(seq 1 45); do sid=$(hunk session list --json 2>/dev/null | jq -r --arg p "$patch" '.sessions[]? | select(.sourceLabel==$p) | .sessionId' | head -1); [ -n "$sid" ] && break; sleep 0.7; done ;;
    esac
    if { [ "$backend" = tuicr ] && [ "$found" != 1 ]; } || { [ "$backend" = hunk ] && [ -z "$sid" ]; }; then
      notify "sniffr" "couldn't attach to the $backend session for PR #${num}."
      echo "sniffr: no open $backend session for PR #${num} — open the reviewer first (e.g. 'tuicr pr $target' / 'hunk patch'), or use --format json." >&2
      exit 1
    fi
  fi

  # consensus runs the review agents in PARALLEL (the barrier is only as long as
  # the slowest agent, not the sum), then merges. Progressive (non-consensus) mode
  # stays sequential so findings land in a stable order as each agent finishes.
  PAR=0
  if [ "$CONSENSUS" = 1 ] && [ -z "${SNIFFR_CMD:-}" ]; then
    PAR=1
    for ag in $AGENTS; do ( run_agent "$ag" > "$scratch/raw.$ag" 2>/dev/null ) & done
    wait
  fi

  # ---- each agent reviews the same diff; inject + reload progressively ------
  total=0; nag=0
  for ag in $AGENTS; do
    nag=$((nag+1))
    if [ "$PAR" = 1 ] && [ -f "$scratch/raw.$ag" ]; then cp "$scratch/raw.$ag" "$scratch/agent.out"
    else printf '%s' "$(run_agent "$ag")" > "$scratch/agent.out"; fi
    # Extract this agent's JSON array, then ANCHOR each finding to a real line by
    # matching its verbatim `code` quote against the diff (line is a fallback).
    # Program via heredoc on stdin; diff + agent output are passed as FILE ARGS.
    findings=$(python3 - "$scratch/diff.patch" "$scratch/agent.out" <<'PY'
import sys, json, re, os

diff_path = sys.argv[1]
raw = open(sys.argv[2], errors="replace").read()

def extract_array(s):
    i = s.find("[")
    while i != -1:
        for j in range(len(s), i, -1):
            try:
                v = json.loads(s[i:j])
                if isinstance(v, list):
                    return v
            except Exception:
                pass
        i = s.find("[", i + 1)
    return []

findings = extract_array(raw)

# Parse the unified diff -> {path: [(new_line_no, text), ...]} for new-side lines
try:
    with open(diff_path, errors="replace") as f:
        diff = f.read()
except Exception:
    diff = ""

files, cur, newno = {}, None, None
hunk_re = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")
for ln in diff.split("\n"):
    if ln.startswith("+++ "):
        p = ln[4:].strip().split("\t", 1)[0]
        if p.startswith("b/"):
            p = p[2:]
        cur = None if p == "/dev/null" else p
        if cur is not None:
            files.setdefault(cur, [])
        newno = None
    elif ln.startswith("--- "):
        continue
    else:
        m = hunk_re.match(ln)
        if m:
            newno = int(m.group(1))
        elif cur is None or newno is None:
            continue
        elif ln.startswith("+"):
            files[cur].append((newno, ln[1:])); newno += 1
        elif ln.startswith("-") or ln.startswith("\\"):
            pass
        else:
            files[cur].append((newno, ln[1:] if ln.startswith(" ") else ln)); newno += 1

def match_file(fpath):
    if not fpath:
        return None
    if fpath in files:
        return fpath
    for k in files:                       # suffix match (agent may give partial path)
        if k.endswith(fpath) or fpath.endswith(k):
            return k
    base = os.path.basename(fpath)
    cands = [k for k in files if os.path.basename(k) == base]
    return cands[0] if len(cands) == 1 else None

def resolve_line(fkey, code, hint):
    lines = files.get(fkey or "", [])
    if not lines:
        return None
    c = (code or "").strip()
    if c:
        exact = [no for no, t in lines if t.strip() == c]
        if len(exact) == 1:
            return exact[0]
        if len(exact) > 1:
            return min(exact, key=lambda no: abs(no - hint)) if isinstance(hint, int) else exact[0]
        sub = [no for no, t in lines if t.strip() and (c in t.strip() or t.strip() in c)]
        if len(sub) == 1:
            return sub[0]
        if len(sub) > 1 and isinstance(hint, int):
            return min(sub, key=lambda no: abs(no - hint))
    if isinstance(hint, int):             # fall back to the counted line if plausible
        nos = [no for no, _ in lines]
        if nos and min(nos) <= hint <= max(nos):
            return hint
    return None

out = []
for it in findings:
    if not isinstance(it, dict):
        continue
    body = (it.get("body") or "").strip()
    fpath = (it.get("file") or "").strip()
    if not body or not fpath:
        continue
    hint = it.get("line") if isinstance(it.get("line"), int) else None
    fkey = match_file(fpath)
    sev = str(it.get("severity") or "").strip().lower()
    if sev not in ("critical", "high", "medium", "low"):
        sev = None
    conf = it.get("confidence")
    conf = round(float(conf), 2) if isinstance(conf, (int, float)) and 0 <= conf <= 1 else None
    rec = (it.get("recommendation") or "").strip() or None
    rec_item = {
        "file": fkey or fpath,
        "line": resolve_line(fkey, it.get("code"), hint),
        "type": it.get("type") or "note",
        "severity": sev,
        "confidence": conf,
        "body": body,
        "recommendation": rec,
    }
    out.append({k: v for k, v in rec_item.items() if v is not None})

print(json.dumps(out))
PY
)
    # noise filters — drop findings below --min-severity / --min-confidence.
    # A finding missing that field is kept (never silently drop an unranked bug).
    if [ -n "$MIN_SEV" ] || [ -n "$MIN_CONF" ]; then
      findings=$(printf '%s' "$findings" | jq -c --arg ms "${MIN_SEV:-}" --argjson mc "${MIN_CONF:-0}" '
        def rk(s): {critical:4,high:3,medium:2,low:1}[s] // 0;
        rk($ms) as $min
        | [ .[] | select( ($ms=="" or .severity==null or rk(.severity) >= $min)
                          and (.confidence==null or .confidence >= $mc) ) ]' 2>/dev/null) || findings="$findings"
    fi
    # --format json: accumulate findings (tagged by agent) and skip injection
    if [ "$FORMAT" = json ]; then
      jq -c --slurpfile prev "$scratch/all.json" --arg a "$ag" \
        '$prev[0] + [ .[] | . + {agent:$a} ]' <<<"$findings" > "$scratch/all.json.tmp" 2>/dev/null \
        && mv "$scratch/all.json.tmp" "$scratch/all.json"
      total=$((total + $(printf '%s' "$findings" | jq 'length' 2>/dev/null || echo 0)))
      continue
    fi
    # consensus: pool this agent's findings (tagged); the merge happens after the loop
    if [ "$CONSENSUS" = 1 ]; then
      jq -c --slurpfile prev "$scratch/all.json" --arg a "$ag" \
        '$prev[0] + [ .[] | . + {agent:$a} ]' <<<"$findings" > "$scratch/all.json.tmp" 2>/dev/null \
        && mv "$scratch/all.json.tmp" "$scratch/all.json"
      continue
    fi
    # ---- inject this agent's findings, stamped with its name --------------
    n=0
    case "$backend" in
    tuicr)
      while IFS= read -r item; do
        [ -n "$item" ] || continue
        file=$(jq -r '.file // empty'  <<<"$item"); line=$(jq -r '.line // empty' <<<"$item")
        typ=$( jq -r '.type // "note"' <<<"$item"); body=$(jq -r '.body // empty' <<<"$item")
        [ -n "$file" ] && [ -n "$body" ] || continue
        # badge: severity icon + label, then the finding, then the fix.
        # confidence is carried in the finding (used internally for
        # ranking/dedupe) but intentionally NOT shown in the comment.
        sev=$(jq -r '.severity // empty' <<<"$item"); rec=$(jq -r '.recommendation // empty' <<<"$item")
        icon=""; case "$sev" in critical) icon="🔴";; high) icon="🟠";; medium) icon="🟡";; low) icon="⚪";; esac
        disp="$body"; [ -n "$sev" ] && disp="$icon $sev"$'\n'"$body"
        [ -n "$rec" ] && [ "$rec" != null ] && disp="$disp"$'\n'"↳ fix: $rec"
        if [ -n "$line" ] && [ "$line" != "null" ]; then
          tuicr review add --session "$slug" --repo "$repo" --type "$typ" --target-file "$file" --line "$line" --side new --username "$ag" "$disp" >/dev/null 2>&1 && n=$((n+1))
        else
          tuicr review add --session "$slug" --repo "$repo" --type "$typ" --target-file "$file" --username "$ag" "$disp" >/dev/null 2>&1 && n=$((n+1))
        fi
      done < <(printf '%s' "$findings" | jq -c '.[]?')
      [ -n "${SNIFFR_AFTER_INJECT:-}" ] && sh -c "$SNIFFR_AFTER_INJECT" >/dev/null 2>&1 || true ;;
    hunk)
      # hunk has no native comment type, so render the badge (severity · type +
      # fix) into the summary text.
      batch="[]"
      while IFS= read -r item; do
        [ -n "$item" ] || continue
        line=$(jq -r '.line // empty' <<<"$item"); { [ -z "$line" ] || [ "$line" = null ]; } && continue
        file=$(jq -r '.file // "?"' <<<"$item"); disp=$(mkbadge "$item")
        obj=$(jq -n --arg f "$file" --argjson l "$line" --arg s "$disp" --arg a "$ag" '{filePath:$f,newLine:$l,summary:$s,author:$a}')
        batch=$(jq -c --argjson o "$obj" '. + [$o]' <<<"$batch")
      done < <(printf '%s' "$findings" | jq -c '.[]?')
      n=$(jq 'length' <<<"$batch")
      [ "${n:-0}" -gt 0 ] && { jq -n --argjson c "$batch" '{comments:$c}' | hunk session comment apply "$sid" --stdin --focus >/dev/null 2>&1 || n=0; } ;;
    *)
      inj=$(cfg_backend_cmd "$backend" inject)
      if [ -n "$inj" ]; then inj=$(expand_ph "$inj"); printf '%s' "$findings" | ( eval "$inj" ) >/dev/null 2>&1 && n=$(printf '%s' "$findings" | jq 'length' 2>/dev/null || echo 0); fi ;;
    esac
    total=$((total + ${n:-0}))
  done

  # ---- consensus: merge the pooled findings into one comment per bug ----------
  if [ "$CONSENSUS" = 1 ]; then
    pooln=$(jq 'length' "$scratch/all.json" 2>/dev/null || echo 0)
    merged=$(printf '%s\n\nFINDINGS:\n%s' "${CPROMPT:-$DEFAULT_CPROMPT}" "$(cat "$scratch/all.json")" \
      | run_model "$CAGENT" "$CMODEL" | python3 "$scratch/xarr.py")
    mn=$(printf '%s' "$merged" | jq 'length' 2>/dev/null || echo 0)
    # if the merge failed/emptied but agents did find things, fall back to the raw
    # pooled findings rather than silently dropping the whole review.
    if [ "${mn:-0}" = 0 ] && [ "${pooln:-0}" -gt 0 ]; then
      echo "sniffr: consensus merge returned nothing — falling back to raw pooled findings." >&2
      merged="$(cat "$scratch/all.json")"
    fi
    [ -n "$merged" ] || merged='[]'
    total=$(printf '%s' "$merged" | jq 'length' 2>/dev/null || echo 0)
    if [ "$FORMAT" = json ]; then printf '%s\n' "$merged"; exit 0; fi
    n=0
    case "$backend" in
    tuicr)
      while IFS= read -r item; do
        [ -n "$item" ] || continue
        file=$(jq -r '.file // empty' <<<"$item"); line=$(jq -r '.line // empty' <<<"$item"); typ=$(jq -r '.type // "note"' <<<"$item")
        [ -n "$file" ] || continue
        disp=$(mkbadge "$item")
        if [ -n "$line" ] && [ "$line" != null ]; then
          tuicr review add --session "$slug" --repo "$repo" --type "$typ" --target-file "$file" --line "$line" --side new --username consensus "$disp" >/dev/null 2>&1 && n=$((n+1))
        else
          tuicr review add --session "$slug" --repo "$repo" --type "$typ" --target-file "$file" --username consensus "$disp" >/dev/null 2>&1 && n=$((n+1))
        fi
      done < <(printf '%s' "$merged" | jq -c '.[]?')
      [ -n "${SNIFFR_AFTER_INJECT:-}" ] && sh -c "$SNIFFR_AFTER_INJECT" >/dev/null 2>&1 || true ;;
    hunk)
      batch="[]"
      while IFS= read -r item; do
        [ -n "$item" ] || continue
        line=$(jq -r '.line // empty' <<<"$item"); { [ -z "$line" ] || [ "$line" = null ]; } && continue
        file=$(jq -r '.file // "?"' <<<"$item"); disp=$(mkbadge "$item")
        obj=$(jq -n --arg f "$file" --argjson l "$line" --arg s "$disp" --arg a consensus '{filePath:$f,newLine:$l,summary:$s,author:$a}')
        batch=$(jq -c --argjson o "$obj" '. + [$o]' <<<"$batch")
      done < <(printf '%s' "$merged" | jq -c '.[]?')
      n=$(jq 'length' <<<"$batch")
      [ "${n:-0}" -gt 0 ] && { jq -n --argjson c "$batch" '{comments:$c}' | hunk session comment apply "$sid" --stdin --focus >/dev/null 2>&1 || n=0; } ;;
    *)
      inj=$(cfg_backend_cmd "$backend" inject)
      if [ -n "$inj" ]; then inj=$(expand_ph "$inj"); printf '%s' "$merged" | ( eval "$inj" ) >/dev/null 2>&1 && n=$total; fi ;;
    esac
    if [ "${n:-0}" -gt 0 ]; then notify "sniffr — consensus ready" "$nag agents → $n merged comment(s) on PR #${num}."
    else notify "sniffr" "sniffed PR #${num} and flagged nothing."; fi
    exit 0
  fi

  if [ "$FORMAT" = json ]; then cat "$scratch/all.json"; exit 0; fi
  if [ "${total:-0}" -gt 0 ]; then notify "sniffr — review ready" "$nag agent(s) left $total comment(s) on PR #${num}."
  else                             notify "sniffr" "sniffed PR #${num} and flagged nothing."
  fi
  exit 0
fi

# ===================== setup: print the agent setup prompt ====================
# `sniffr setup | pbcopy` (or just read it) → paste into a coding agent and it
# walks the install/config for you.
if [ "${1:-}" = "setup" ]; then
  src="${BASH_SOURCE[0]:-$0}"
  while [ -L "$src" ]; do t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac; done
  root="$(cd "$(dirname "$src")/.." 2>/dev/null && pwd)"
  if [ -f "$root/SETUP_PROMPT.md" ]; then cat "$root/SETUP_PROMPT.md"
  else echo "sniffr: SETUP_PROMPT.md not found (looked in $root) — see https://github.com/tomasvarga/sniffr" >&2; exit 1; fi
  exit 0
fi

# ============================ doctor: preflight check =========================
if [ "${1:-}" = "doctor" ]; then
  ok(){ printf '  \033[32m✓\033[0m %s\n' "$1"; }
  no(){ printf '  \033[31m✗\033[0m %s\n' "$1"; MISS=1; }
  MISS=0
  echo "sniffr doctor"
  echo "core dependencies:"
  for b in gh jq python3; do
    if command -v "$b" >/dev/null; then ok "$b"; else no "$b — required"; fi
  done
  echo "environment:"
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then ok "gh authenticated"; else no "gh not authenticated — run: gh auth login"; fi
  echo "review agent:"
  A="$(default_agent)"
  if [ -n "${SNIFFR_CMD:-}" ]; then ok "SNIFFR_CMD set — using a custom command"
  else
    b=$(agent_bin "$A")
    if command -v "$b" >/dev/null; then ok "default agent '$A' ($b) found"
    else no "default agent '$A' ($b) not installed — install it, use --agent, or set SNIFFR_CMD"; fi
  fi
  echo "backend:"
  BK="$(resolve_backend)"
  case "$BK" in
    tuicr) command -v tuicr >/dev/null && ok "tuicr (native, default)" || no "$(backend_missing_hint tuicr)" ;;
    hunk)  command -v hunk  >/dev/null && ok "hunk (native)"  || no "$(backend_missing_hint hunk)" ;;
    *)     if [ -n "$(cfg_backend_cmd "$BK" inject)" ]; then ok "custom backend '$BK' (inject: $(cfg_backend_cmd "$BK" inject))"
           else no "backend '$BK' is neither a native backend nor defined in $CONFIG_FILE"; fi ;;
  esac
  echo "notifications:"
  if   [ -n "${SNIFFR_NOTIFY_CMD:-}" ];          then ok "SNIFFR_NOTIFY_CMD set — custom notifier"
  elif command -v terminal-notifier >/dev/null; then ok "terminal-notifier (OS notifications)"
  elif command -v osascript >/dev/null;         then ok "osascript (macOS notifications)"
  else no "no notifier available (optional) — set SNIFFR_NOTIFY_CMD or install terminal-notifier"; fi
  echo ""
  [ "$MISS" = 0 ] && echo "all good — sniffr is ready." || echo "some checks failed (see ✗ above)."
  exit "$MISS"
fi

# ==================== queue: pick a PR from your review list ===================
# A target picker only — the choice is handed back to the normal path via exec,
# so `queue` can never drift from `sniffr <pr>`. Defaults: recent · human · ready.
if [ "${1:-}" = "queue" ]; then
  shift
  since="21d"; want_bots=0; want_drafts=0; agent_pass=""; backend_pass=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)   since="${2:-}"; shift 2 ;;
      --since=*) since="${1#*=}"; shift ;;
      --agent)   agent_pass="${2:-}"; shift 2 ;;
      --agent=*) agent_pass="${1#*=}"; shift ;;
      --backend)   backend_pass="${2:-}"; shift 2 ;;
      --backend=*) backend_pass="${1#*=}"; shift ;;
      --all)     since=""; want_bots=1; want_drafts=1; shift ;;
      --include-bots) want_bots=1; shift ;;
      --drafts)  want_drafts=1; shift ;;
      -*) die "queue: unknown flag: $1" ;;
      *)  die "queue takes no positional args (got '$1')" ;;
    esac
  done
  for b in gh jq; do command -v "$b" >/dev/null || die "missing dependency: $b"; done

  # --since 21d|3w|2mo|1y  →  a `gh --updated` server-side date filter
  updated=""
  if [ -n "$since" ]; then
    cutoff=$(date_ago "$since") || die "queue: --since wants e.g. 21d, 3w, 2mo, 1y (got '$since')"
    updated=">=$cutoff"
  fi

  # opt-out filters as jq predicates
  botf='select(.author.login | test("dependabot|renovate|-bot$|\\[bot\\]") | not)'
  [ "$want_bots" = 1 ] && botf='.'
  draftf='select(.isDraft | not)'
  [ "$want_drafts" = 1 ] && draftf='.'

  rows=$(gh search prs --review-requested=@me --state=open --limit 200 \
           ${updated:+--updated "$updated"} \
           --json url,title,repository,author,isDraft,updatedAt \
           --jq ".[] | $botf | $draftf
                 | [.updatedAt, .url, (.repository.nameWithOwner + \"  —  \" + .title)]
                 | @tsv" 2>/dev/null | sort -r)
  [ -n "$rows" ] || { echo "sniffr queue: nothing needs your review${since:+ (active in last $since)}."; exit 0; }

  urls=(); labels=(); n=0
  while IFS=$'\t' read -r _u url label; do
    [ -n "$url" ] || continue
    urls[$n]="$url"; labels[$n]="$label"; n=$((n+1))
  done <<EOF
$rows
EOF

  sel=0; esc=$(printf '\033')
  draw(){
    printf '%s[1mNeeds your review (%d)%s[0m\r\n' "$esc" "$n" "$esc"
    local i
    for i in $(seq 0 $((n-1))); do
      if [ "$i" = "$sel" ]; then printf '%s[7m → [%d] %s %s[0m\r\n' "$esc" $((i+1)) "${labels[$i]}" "$esc"
      else                       printf '   [%d] %s\r\n' $((i+1)) "${labels[$i]}"; fi
    done
    printf '   [q] cancel\r\n'
  }
  cleanup(){ printf '%s[?25h' "$esc"; }
  trap cleanup EXIT
  printf '%s[?25l' "$esc"; draw
  while IFS= read -rsn1 key; do
    case "$key" in
      "$esc") IFS= read -rsn2 rest
              case "$rest" in "[A") sel=$(((sel-1+n)%n)) ;; "[B") sel=$(((sel+1)%n)) ;; esac ;;
      q|Q) cleanup; echo "queue: cancelled."; exit 0 ;;
      [1-9]) idx=$((key-1)); [ "$idx" -lt "$n" ] && { sel=$idx; break; } ;;
      "") break ;;                                 # Enter
    esac
    printf '%s[%dA' "$esc" $((n+1)); draw
  done
  cleanup
  chosen="${urls[$sel]}"
  [ -n "$chosen" ] || exit 0
  echo "sniffr: → $chosen"
  set -- "$chosen"
  [ -n "$agent_pass" ]   && set -- --agent "$agent_pass" "$@"
  [ -n "$backend_pass" ] && set -- --backend "$backend_pass" "$@"
  # SNIFFR_REEXEC lets a host wrapper (e.g. herdr-sniffr) route the picked PR
  # back through itself — so `queue` opens a pane just like `sniffr <pr>` does.
  exec "${SNIFFR_REEXEC:-$0}" "$@"
fi

# ---- open-cmd: print the command that launches the reviewer's viewer --------
# A building block for host wrappers that open the viewer themselves (e.g.
# herdr-sniffr opens it in a herdr pane): given a PR, print the shell command
# that launches the resolved backend's viewer. Prepares the diff file for
# backends that need it. Host-agnostic — it only prints a command string.
if [ "${1:-}" = "open-cmd" ]; then
  shift
  target=""; BACKEND_OPT=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --backend) BACKEND_OPT="${2:-}"; shift 2 ;;
      --backend=*) BACKEND_OPT="${1#*=}"; shift ;;
      --agent|--model|--format|--after-inject|--notify-cmd) shift 2 ;;  # value flags
      --*=*) shift ;;
      --*) shift ;;            # boolean flag (e.g. --bg)
      *) target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die "usage: sniffr open-cmd <pr> [--backend tuicr|hunk|<custom>]"
  for b in gh jq python3; do command -v "$b" >/dev/null || die "missing dependency: $b"; done
  backend="$(resolve_backend)"
  resolve "$target"
  DIFF_PATH=""
  case "$backend" in
    tuicr) printf 'tuicr pr %s\n' "$target" ;;
    hunk)  DIFF_PATH="${TMPDIR:-/tmp}/sniffr-${num}.patch"
           gh pr diff "$num" --repo "$repo" > "$DIFF_PATH" 2>/dev/null || die "could not fetch diff for #${num}"
           printf 'hunk patch %q\n' "$DIFF_PATH" ;;
    *)     oc="$(cfg_backend_cmd "$backend" open)"
           if [ -n "$oc" ]; then
             DIFF_PATH="${TMPDIR:-/tmp}/sniffr-${num}.patch"
             gh pr diff "$num" --repo "$repo" > "$DIFF_PATH" 2>/dev/null || true
             printf '%s\n' "$(expand_ph "$oc")"
           fi ;;
  esac
  exit 0
fi

# ========================= MAIN: open tuicr + spawn worker ====================
AGENT="$(default_agent)"; target=""; BACKEND_OPT=""; MODEL_OPT=""
FORMAT_OPT=""; AFTER_INJECT=""; NOTIFY_CMD=""; BG=0; CONSENSUS_OPT=""; MIN_SEV_OPT=""; MIN_CONF_OPT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) AGENT="${2:-}"; shift 2 ;;
    --agent=*) AGENT="${1#*=}"; shift ;;
    --backend) BACKEND_OPT="${2:-}"; shift 2 ;;
    --backend=*) BACKEND_OPT="${1#*=}"; shift ;;
    --model) MODEL_OPT="${2:-}"; shift 2 ;;
    --model=*) MODEL_OPT="${1#*=}"; shift ;;
    --consensus) CONSENSUS_OPT=1; shift ;;
    --consensus=*) CONSENSUS_OPT="${1#*=}"; shift ;;
    --min-severity) MIN_SEV_OPT="${2:-}"; shift 2 ;;
    --min-severity=*) MIN_SEV_OPT="${1#*=}"; shift ;;
    --min-confidence) MIN_CONF_OPT="${2:-}"; shift 2 ;;
    --min-confidence=*) MIN_CONF_OPT="${1#*=}"; shift ;;
    --bg|--background|--async) BG=1; shift ;;
    --format) FORMAT_OPT="${2:-}"; shift 2 ;;
    --format=*) FORMAT_OPT="${1#*=}"; shift ;;
    --after-inject) AFTER_INJECT="${2:-}"; shift 2 ;;
    --after-inject=*) AFTER_INJECT="${1#*=}"; shift ;;
    --notify-cmd) NOTIFY_CMD="${2:-}"; shift 2 ;;
    --notify-cmd=*) NOTIFY_CMD="${1#*=}"; shift ;;
    --set-agent) a="${2:-}"; [ -n "$a" ] || die "usage: sniffr --set-agent <name>"
      case "$a" in codex|claude|cursor|cursor-agent|grok|opencode|ollama) ;;
        *) echo "sniffr: note — '$a' isn't a built-in; set SNIFFR_CMD for a custom tool" >&2 ;; esac
      mkdir -p "$CONF_DIR"; printf '%s\n' "$a" > "$CONF_DIR/agent"
      echo "sniffr: default agent set to '$a' (~/.config/sniffr/agent)"; exit 0 ;;
    --show-agent) echo "sniffr: default agent = $(default_agent)"; exit 0 ;;
    -h|--help) sed -n '2,37p' "$0"; exit 0 ;;
    -*) die "unknown flag: $1" ;;
    *) target="$1"; shift ;;
  esac
done
[ -n "$target" ] || die "usage: sniffr <pr> [--agent NAME] [--backend tuicr|hunk|<custom>] [--bg] [--format json]"
FORMAT="${FORMAT_OPT:-inject}"
case "$FORMAT" in inject|json) ;; *) die "unknown --format '$FORMAT' (use: inject | json)" ;; esac
[ "$BG" = 1 ] && [ "$FORMAT" = json ] && die "--bg and --format json are mutually exclusive (json prints to stdout, so it must run in the foreground)"
backend="$(resolve_backend)"
backend_known "$backend" || die "unknown backend '$backend'. Native: tuicr, hunk. Define custom backends under [backends.$backend] in $CONFIG_FILE."
for b in gh jq python3; do command -v "$b" >/dev/null || die "missing dependency: $b"; done
# --format json emits findings to stdout and needs no reviewer installed.
if [ "$FORMAT" != json ]; then
  case "$backend" in
    tuicr) command -v tuicr >/dev/null || die "$(backend_missing_hint tuicr)" ;;
    hunk)  command -v hunk  >/dev/null || die "$(backend_missing_hint hunk)" ;;
  esac
fi
if [ -z "${SNIFFR_CMD:-}" ]; then
  # --agent may be a comma list (multi-agent review); validate + check each
  for ag in ${AGENT//,/ }; do
    case "$ag" in codex|claude|cursor|cursor-agent|grok|opencode|ollama) : ;;
      *) die "unknown agent '$ag'. Built-ins: codex claude cursor-agent grok opencode ollama — or set SNIFFR_CMD='<cmd>'." ;; esac
    ab=$(agent_bin "$ag")
    command -v "$ab" >/dev/null || die "agent '$ag' selected but '$ab' isn't installed or on PATH — install it, pick another with --agent, set SNIFFR_CMD='<cmd>', or run 'sniffr doctor'."
  done
fi
resolve "$target"

# Attach mode: inject into a reviewer session you already have open.
#   --format inject (default) → resolve findings and inject into the reviewer
#     (tuicr/hunk/custom); notify + fire --after-inject when they land.
#   --format json → print the resolved findings as a JSON array to stdout and
#     exit (no reviewer needed) — the building block other tools wrap.
#   --bg → detach a background worker and return immediately, so you keep
#     reading while the agent reviews; comments + notification land later.
#     (Default is foreground/synchronous — required for --format json, and
#     easier to see errors like "no reviewer open".)
# The herdr plugin (herdr-sniffr) opens the pane, then calls sniffr --bg and
# passes the reload nudge via --after-inject; the core stays host-agnostic.
worker_env=(
  SNIFFR_AGENT="$AGENT"
  SNIFFR_MODEL="${MODEL_OPT:-${SNIFFR_MODEL:-}}"
  SNIFFR_FORMAT="$FORMAT"
  SNIFFR_AFTER_INJECT="${AFTER_INJECT:-${SNIFFR_AFTER_INJECT:-}}"
  SNIFFR_NOTIFY_CMD="${NOTIFY_CMD:-${SNIFFR_NOTIFY_CMD:-}}"
  SNIFFR_CONSENSUS="${CONSENSUS_OPT:-${SNIFFR_CONSENSUS:-}}"
  SNIFFR_MIN_SEVERITY="${MIN_SEV_OPT:-${SNIFFR_MIN_SEVERITY:-}}"
  SNIFFR_MIN_CONFIDENCE="${MIN_CONF_OPT:-${SNIFFR_MIN_CONFIDENCE:-}}"
)
if [ "$BG" = 1 ]; then
  log="${TMPDIR:-/tmp}/sniffr-${num}.log"
  nohup env "${worker_env[@]}" "$0" --worker "$target" "" "$backend" >"$log" 2>&1 </dev/null &
  disown 2>/dev/null || true
  echo "sniffr: ${AGENT} sniffing #${num} in the background → ${backend} (log: $log)"
  echo "  ${url}"
  exit 0
fi
[ "$FORMAT" = json ] || echo "sniffr: sniffing #${num} with ${AGENT} → ${backend} …"
exec env "${worker_env[@]}" "$0" --worker "$target" "" "$backend"
